// Mẫu cho src/services/goiTapService.js; utils/http phải được tạo khi bootstrap.
import http from '../utils/http'

export function layDanhSachGoiTap(thamSo = {}) {
  return http.get('/goi-tap', { params: thamSo })
}

export function taoGoiTap(duLieu) {
  return http.post('/admin/goi-tap', duLieu)
}

export function capNhatGoiTap(id, duLieu) {
  return http.patch(`/admin/goi-tap/${id}`, duLieu)
}
