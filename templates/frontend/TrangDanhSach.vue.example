<!-- Mẫu minh họa; các service/component thực chưa được tạo. -->
<template>
  <section>
    <h1>Gói tập</h1>
    <p v-if="dangTai" role="status">Đang tải danh sách...</p>
    <p v-else-if="thongBaoLoi" role="alert">{{ thongBaoLoi }}</p>
    <p v-else-if="!danhSach.length">Chưa có gói tập.</p>
    <ul v-else>
      <li v-for="goiTap in danhSach" :key="goiTap.id">
        {{ goiTap.ten_goi }}
      </li>
    </ul>
    <button type="button" :disabled="dangTai" @click="taiDanhSach">
      Làm mới
    </button>
  </section>
</template>

<script>
import { layDanhSachGoiTap } from '../../../services/goiTapService'

export default {
  name: 'DanhSachGoiTap',
  data() {
    return {
      danhSach: [],
      dangTai: false,
      thongBaoLoi: '',
    }
  },
  created() {
    this.taiDanhSach()
  },
  methods: {
    async taiDanhSach() {
      if (this.dangTai) return
      this.dangTai = true
      this.thongBaoLoi = ''

      try {
        const { data } = await layDanhSachGoiTap({ page: 1, per_page: 20 })
        this.danhSach = data.data
      } catch (loi) {
        this.thongBaoLoi = loi.response?.data?.message || 'Không thể tải dữ liệu.'
      } finally {
        this.dangTai = false
      }
    },
  },
}
</script>
