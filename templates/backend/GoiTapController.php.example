<?php

// Mẫu minh họa, chưa có Model/Request/Policy/Resource tương ứng.
// Base Controller phải hỗ trợ authorize qua AuthorizesRequests khi bootstrap.
namespace App\Http\Controllers\Api\Admin;

use App\Http\Controllers\Controller;
use App\Http\Requests\TaoGoiTapRequest;
use App\Http\Resources\GoiTapResource;
use App\Models\GoiTap;
use Illuminate\Http\JsonResponse;

class GoiTapController extends Controller
{
    public function store(TaoGoiTapRequest $request): JsonResponse
    {
        $this->authorize('create', GoiTap::class);

        // CRUD một record không cần service/transaction nhiều bước chỉ để thêm lớp.
        $goiTap = GoiTap::create($request->validated());

        return response()->json([
            'status' => true,
            'message' => 'Tạo gói tập thành công.',
            'data' => new GoiTapResource($goiTap),
        ], 201);
    }
}
