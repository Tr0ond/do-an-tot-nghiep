# Android/iOS: URL Backend tuyệt đối, không chứa khóa hoặc token.
# LDPlayer dùng adb reverse tcp:8000 tcp:8000 rồi trỏ về loopback này.
# Điện thoại thật cần địa chỉ LAN/HTTPS thử nghiệm truy cập được.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Reverb public key giống cấu hình web; KHÔNG điền app secret hoặc API key AI.
# Thiếu cấu hình socket: app vẫn đồng bộ HTTP mỗi 45 giây khi đang mở.
EXPO_PUBLIC_REVERB_URL=ws://127.0.0.1:8080
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_ORIGIN=http://localhost

# UUID công khai của dự án Expo/EAS để lấy ExpoPushToken trong bản cài riêng.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Đường dẫn google-services.json cho package vn.fitforge.app, không chứa khóa server Firebase.
# GOOGLE_SERVICES_FILE=./google-services.json
